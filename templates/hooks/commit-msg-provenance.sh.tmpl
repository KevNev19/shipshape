#!/usr/bin/env bash
# What this is: an optional label check for one commit-message line,
# Agent-Assisted-By. A commit with no such line is allowed. A line that is
# present must name the tool in a short plain phrase. This hook does not
# decide who wrote the commit, and it is not a safety or quality check.
# Safe to edit: yes — shipshape will ask before overwriting your edits.
# managed-by: shipshape v{{KIT_VERSION}}
set -u

if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
  echo "ERROR: the commit label check needs the commit message file." >&2
  echo "A commit with no Agent-Assisted-By line is allowed. This is not a safety check." >&2
  exit 1
fi

invalid=0
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"
  case "$line" in
    Agent-Assisted-By:*)
      value="${line#Agent-Assisted-By:}"
      if [[ ! "$value" =~ ^\ [A-Za-z0-9][A-Za-z0-9\ ._+-]{0,63}$ ]] || [[ "$value" == *" " ]]; then
        invalid=1
      fi
      ;;
  esac
done < "$1"

if [ "$invalid" -ne 0 ]; then
  echo "ERROR: Agent-Assisted-By must look like 'Agent-Assisted-By: Tool Name'." >&2
  echo "Remove the line to commit without a label. The label is not a safety check." >&2
  exit 1
fi
exit 0

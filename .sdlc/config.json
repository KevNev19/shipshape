{
  "version": 1,
  "kit_version": "0.2.0",
  "profile": "solo",
  "workflow_style": "trunk",
  "project_name": "shipshape",
  "languages": [
    "python"
  ],
  "default_branch": "main",
  "features": {
    "codeql": true,
    "dependabot": true,
    "secret_guard": true,
    "branch_protection": true,
    "release_automation": true,
    "issue_templates": true,
    "project_board": false,
    "github_agents": true
  },
  "commands": {
    "test": "python3 -m pytest tests/ -q",
    "lint": ""
  },
  "toolchain": {
    "python": "3.12",
    "node": "20",
    "go": "1.22"
  },
  "release": {
    "versioning": "semver"
  },
  "owners": {
    "default": ""
  },
  "repo": {
    "owner_repo": ""
  }
}
